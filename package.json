{
  "name": "blacklist-butler",
  "version": "1.0.0",
  "description": "Blacklist manager",
  "main": "index.ts",
  "scripts": {
    "dev": "bun src/index.ts --watch",
    "start": "bun src/index.ts",
    "lint": "oxlint src tests --deny-warnings",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "migrate:postgres-schema": "bun src/Postgres/apply-migrations.ts",
    "migrate:supabase-to-postgres": "bun src/Postgres/supabase-to-postgres.ts",
    "docker:build": "docker build -t blacklist-butler .",
    "docker:run": "docker run -d -p 3000:3000 --name blacklist-butler blacklist-butler",
    "docker:stop": "docker stop blacklist-butler",
    "docker:prune-hard": "docker system prune -a"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkLordOfDeadstiny/Blacklist-Butler.git"
  },
  "author": "Patrick Bohn Matthiesen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DarkLordOfDeadstiny/Blacklist-Butler/issues"
  },
  "homepage": "https://github.com/DarkLordOfDeadstiny/Blacklist-Butler#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "discord.js": "14.28.1",
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^25.9.9",
    "nodemon": "^3.1.14",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  },
  "patchedDependencies": {
    "@supabase/auth-js@2.119.0": "patches/@supabase%2Fauth-js@2.119.0.patch",
    "gaxios@7.3.1": "patches/gaxios@7.3.1.patch"
  }
}
